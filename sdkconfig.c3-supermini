# ESP32-C3 SuperMini (hw-466ab): ESP32-C3FN4 (single core, 400 KB SRAM),
# 4 MB embedded flash in DIO mode, no PSRAM, native USB-C. BOOT button on
# GPIO9, single blue LED on GPIO8 (active low). A status light board,
# without the full UI. Load last, after sdkconfig.defaults.
#
# 4 MB of flash holds one app slot only, so there is no OTA (same tradeoff
# as the 4 MB Waveshare C6 board). Without PSRAM there is no home-network
# tunnel either; the device still pairs and Muse reaches it once the
# control session is up. RAM is trimmed like the AI Passport, the other
# ESP32-C3: sized for pairing, Wi-Fi and one control session.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# The USB-C port is the chip's own USB Serial/JTAG; UART0 is not connected.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_c3_supermini.csv"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_HOMEHUB_BUTTON_GPIO=9
CONFIG_HOMEHUB_BED_SENSOR=y
CONFIG_HOMEHUB_LED_BACKEND_GPIO_LED=y
CONFIG_HOMEHUB_GPIO_LED_PIN=8
CONFIG_HOMEHUB_GPIO_LED_ACTIVE_LOW=y

CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
# Servers may still send 16 KB records, so only shrink outbound.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_HOMEHUB_TUNNEL=n

# Bound TCP and Wi-Fi bursts so they leave room for TLS records while
# pairing and the control session run: four-MSS TCP windows
# (validate_config.cmake allows them on this board).
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
# The block-ack window may be at most twice the static buffers.
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
# The host-side pools under their current names (IDF renames the old
# ACL_BUF_COUNT and HCI_EVT_HI_BUF_COUNT onto these, so only set these):
# the AI Passport's effective 8/8, the proven ESP32-C3 footprint.
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8

# On the C3, IRAM and DRAM are the same 400 KB of SRAM, so every function kept
# in IRAM is heap Wi-Fi and BLE don't get. Nothing here has to run while the
# flash cache is off. Together this moves ~45 KB of code to flash.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=n
CONFIG_GDMA_ISR_HANDLER_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n

# BLE is only for pairing and phone setup: one advertiser and one connection,
# no scanning, no BLE 5 extended advertising, no test mode.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
